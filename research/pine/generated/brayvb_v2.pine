//@version=6
// GENERATED by btclab.pine.emit_strategy from DSL spec 'brayvb_v2' (tf 4h) - do not edit by hand.
// Costs preset binance_perp_taker: fee 0.05%/side. Engine slippage 2 bp/side is NOT modelled
// here (set Properties > Slippage in TradingView to compare). Orders fill at the next bar open.
strategy(title="brayvb v2 (generated)", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, pyramiding=1, commission_type=strategy.commission.percent, commission_value=0.05, margin_long=100, margin_short=100, process_orders_on_close=false)

// --- gc ---
f_filt9x(_a, _s, _i) =>
    int _m2 = 0, int _m3 = 0, int _m4 = 0, int _m5 = 0, int _m6 = 0,
    int _m7 = 0, int _m8 = 0, int _m9 = 0, float _f = .0, _x = (1 - _a)
    _m2 := _i == 9 ? 36  : _i == 8 ? 28 : _i == 7 ? 21 : _i == 6 ? 15 : _i == 5 ? 10 : _i == 4 ? 6 : _i == 3 ? 3 : _i == 2 ? 1 : 0
    _m3 := _i == 9 ? 84  : _i == 8 ? 56 : _i == 7 ? 35 : _i == 6 ? 20 : _i == 5 ? 10 : _i == 4 ? 4 : _i == 3 ? 1 : 0
    _m4 := _i == 9 ? 126 : _i == 8 ? 70 : _i == 7 ? 35 : _i == 6 ? 15 : _i == 5 ? 5  : _i == 4 ? 1 : 0
    _m5 := _i == 9 ? 126 : _i == 8 ? 56 : _i == 7 ? 21 : _i == 6 ? 6  : _i == 5 ? 1  : 0
    _m6 := _i == 9 ? 84  : _i == 8 ? 28 : _i == 7 ? 7  : _i == 6 ? 1  : 0
    _m7 := _i == 9 ? 36  : _i == 8 ? 8  : _i == 7 ? 1  : 0
    _m8 := _i == 9 ? 9   : _i == 8 ? 1  : 0
    _m9 := _i == 9 ? 1   : 0
    _f :=   math.pow(_a, _i) * nz(_s) +
      _i  *     _x      * nz(_f[1])      - (_i >= 2 ?
      _m2 * math.pow(_x, 2)  * nz(_f[2]) : 0) + (_i >= 3 ?
      _m3 * math.pow(_x, 3)  * nz(_f[3]) : 0) - (_i >= 4 ?
      _m4 * math.pow(_x, 4)  * nz(_f[4]) : 0) + (_i >= 5 ?
      _m5 * math.pow(_x, 5)  * nz(_f[5]) : 0) - (_i >= 6 ?
      _m6 * math.pow(_x, 6)  * nz(_f[6]) : 0) + (_i >= 7 ?
      _m7 * math.pow(_x, 7)  * nz(_f[7]) : 0) - (_i >= 8 ?
      _m8 * math.pow(_x, 8)  * nz(_f[8]) : 0) + (_i == 9 ?
      _m9 * math.pow(_x, 9)  * nz(_f[9]) : 0)

f_pole(_a, _s, _i) =>
    _f1 =            f_filt9x(_a, _s, 1),      _f2 = (_i >= 2 ? f_filt9x(_a, _s, 2) : 0), _f3 = (_i >= 3 ? f_filt9x(_a, _s, 3) : 0)
    _f4 = (_i >= 4 ? f_filt9x(_a, _s, 4) : 0), _f5 = (_i >= 5 ? f_filt9x(_a, _s, 5) : 0), _f6 = (_i >= 6 ? f_filt9x(_a, _s, 6) : 0)
    _f7 = (_i >= 2 ? f_filt9x(_a, _s, 7) : 0), _f8 = (_i >= 8 ? f_filt9x(_a, _s, 8) : 0), _f9 = (_i == 9 ? f_filt9x(_a, _s, 9) : 0)
    _fn = _i == 1 ? _f1 : _i == 2 ? _f2 : _i == 3 ? _f3 :
      _i == 4     ? _f4 : _i == 5 ? _f5 : _i == 6 ? _f6 :
      _i == 7     ? _f7 : _i == 8 ? _f8 : _i == 9 ? _f9 : na
    [_fn, _f1]
gc_beta = (1 - math.cos(4*math.asin(1)/144)) / (math.pow(1.414, 2/4) - 1)
gc_alpha = -gc_beta + math.sqrt(math.pow(gc_beta, 2) + 2*gc_beta)
gc_lag = int((144 - 1)/(2*4))
gc_src = hlc3
gc_tr = ta.tr(true)
gc_srcdata = false ? gc_src + (gc_src - gc_src[gc_lag]) : gc_src
gc_trdata = false ? gc_tr + (gc_tr - gc_tr[gc_lag]) : gc_tr
[gc_filtn, gc_filt1] = f_pole(gc_alpha, gc_srcdata, 4)
[gc_filtntr, gc_filt1tr] = f_pole(gc_alpha, gc_trdata, 4)
gc_filt = false ? (gc_filtn + gc_filt1)/2 : gc_filtn
gc_filttr = false ? (gc_filtntr + gc_filt1tr)/2 : gc_filtntr
gc_hband = gc_filt + gc_filttr*1.414
gc_lband = gc_filt - gc_filttr*1.414

// --- stochrsi ---
stochrsi_rsi = ta.rsi(close, 14)
stochrsi_k = ta.sma(ta.stoch(stochrsi_rsi, stochrsi_rsi, stochrsi_rsi, 14), 3)
stochrsi_d = ta.sma(stochrsi_k, 3)

// --- signals ---
long_sig = (gc_filt > gc_filt[1] and close > gc_hband and (stochrsi_k >= 80.0 or stochrsi_k <= 20.0))
exit_long_sig = ta.crossunder(close, gc_hband)

if long_sig
    strategy.entry("long", strategy.long)
if exit_long_sig
    strategy.close("long")
